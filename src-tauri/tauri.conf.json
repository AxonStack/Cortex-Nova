{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cortex Nova",
  "version": "0.1.19",
  "identifier": "com.cortexnova.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cortex Nova — Voice Assistant",
        "width": 800,
        "height": 600,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "opener": {}
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Jarvis-style AI voice assistant for your desktop",
    "longDescription": "Cortex Nova is an always-on AI voice assistant. Say the wake phrase and Nova activates, listens, and acts — opening apps, searching the web, composing emails, and answering anything with AI.",
    "category": "Utility",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libssl3", "xdotool"]
      }
    }
  }
}
